# Konfigurasi Server
PORT=5000
NODE_ENV=development

# Konfigurasi Database MongoDB (Opsional, fallback otomatis ke local JSON dataStore)
MONGODB_URI=mongodb://127.0.0.1:27017/tracer_smapgri2jombang

# Konfigurasi JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Konfigurasi Telegram Bot Storage
# Dapatkan token dari @BotFather dan chat_id dari @userinfobot di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Batasan Ukuran Upload Sesuai Kemampuan Telegram Bot API (dalam MB)
MAX_PHOTO_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=20
